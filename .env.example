# Spark Tool - voorbeeldconfiguratie. Kopieer naar .env (lokaal) of stel in Plesk in.
# Nooit echte waarden committen. Zie docs/deployment/environment-variables.md.

# --- Applicatie ---
NODE_ENV=production
# Passenger zet PORT zelf; lokaal 3000.
PORT=3000
APP_BASE_URL=https://spark.nicenext.nl
APP_BASE_PATH=/tool
# Geheim: MySQL-verbinding. Gebruiker met minimale rechten (geen DROP/GRANT).
DATABASE_URL=mysql://spark_app:CHANGE_ME@localhost:3306/spark_tool
# Geheim: minimaal 32 willekeurige tekens (openssl rand -base64 48)
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
SESSION_COOKIE_NAME=spark.sid

# --- Microsoft Entra ID (single-tenant Juvion) ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Geheim
ENTRA_CLIENT_SECRET=CHANGE_ME
ENTRA_REDIRECT_URI=https://spark.nicenext.nl/tool/auth/callback
ENTRA_POST_LOGOUT_REDIRECT_URI=https://spark.nicenext.nl/tool/login
# Komma-gescheiden object-ID's. Minimaal één van beide is verplicht (default deny).
ENTRA_ALLOWED_GROUP_IDS=
ENTRA_ALLOWED_USER_IDS=

# --- Postmark ---
# Geheim
POSTMARK_SERVER_TOKEN=CHANGE_ME
POSTMARK_FROM_EMAIL=spark@nicenext.nl
POSTMARK_FROM_NAME=Spark
POSTMARK_MESSAGE_STREAM=outbound
# Geheim: wachtwoord voor Basic Auth op de webhook-URL (min. 32 tekens, bv. openssl rand -base64 32)
POSTMARK_WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM
POSTMARK_INBOUND_DOMAIN=

# --- Anthropic ---
# Geheim
ANTHROPIC_API_KEY=CHANGE_ME
# Modelnaam bewust niet hardcoded; kies een actueel model met web search-ondersteuning.
ANTHROPIC_MODEL_LEAD_RESEARCH=
ANTHROPIC_MODEL_CONTENT=
# Maximale geschatte kosten per dag (USD)
ANTHROPIC_MAX_DAILY_COST=5
ANTHROPIC_WEB_SEARCH_MAX_USES=20

# --- Leadgeneratie ---
LEAD_GENERATION_TIMEZONE=Europe/Amsterdam
LEAD_GENERATION_DAILY_TARGET=10
# Gereserveerd; in fase 1 niet gebruikt (planning loopt via de Plesk-taak `npm run jobs:run`)
LEAD_GENERATION_CRON_SECRET=CHANGE_ME_MIN_24_CHARS

# --- Uploads en media ---
UPLOAD_STORAGE_DRIVER=local
# Buiten de document root!
UPLOAD_PRIVATE_PATH=/var/www/vhosts/nicenext.nl/spark-storage/private
UPLOAD_MAX_IMAGE_MB=25
UPLOAD_MAX_VIDEO_MB=300
UPLOAD_TOKEN_TTL_HOURS=72
# Leeg = zoeken in PATH. Als ffmpeg ontbreekt is videoverwerking uitgeschakeld.
FFMPEG_PATH=
SHARP_CONCURRENCY=1

# --- Logging en bewaartermijnen ---
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=730
PROSPECT_RETENTION_DAYS=730
# true achter Apache/Passenger
TRUST_PROXY=true

# --- Alleen lokaal (niet in Plesk): aparte testdatabase voor integratietests ---
# TEST_DATABASE_URL=mysql://spark_app:CHANGE_ME@127.0.0.1:3306/spark_tool_test
