{
  "name": "spark-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spark Tool - CRM, leadgeneratie en content intake (https://tool.nicenext.nl)",
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "node scripts/build/build-web.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/src/server/index.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "verify": "node scripts/verify/verify.mjs",
    "deploy:check": "node scripts/deploy/check-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "node scripts/backup/db-backup.mjs",
    "healthcheck": "node scripts/verify/healthcheck.mjs",
    "jobs:run": "node dist/server/src/server/run-jobs.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@azure/msal-node": "^6.0.1",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "pino": "^10.3.1",
    "postmark": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "cookie-signature": "^1.2.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
